[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/recipe_row.gd" id="1_row"]
[ext_resource type="PackedScene" path="res://scenes/ui/slot_widget.tscn" id="2_slot"]

[node name="RecipeRow" type="HBoxContainer"]
